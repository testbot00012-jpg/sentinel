# CyberShield Environment Variables

PROJECT_NAME="CyberShield Security Platform"
VERSION="1.0.0"
ENV="production"

# Database Configuration (PostgreSQL in production, SQLite async in development)
DATABASE_URL="postgresql+asyncpg://cybershield_user:StrongSecurePassword2026@localhost:5432/cybershield_db"
# DATABASE_URL="sqlite+aiosqlite:///./cybershield.db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Security & Cryptography
SECRET_KEY="generate-a-64-character-random-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH="/etc/secrets/firebase-service-account.json"
FIREBASE_PROJECT_ID="cybershield-security"

# Supabase Configuration (Credentials, Auth & Account Activity)
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_KEY="eyJh...your-anon-key..."
SUPABASE_SERVICE_ROLE_KEY="eyJh...your-service-role-key..."

# Storage
STORAGE_DIR="./storage"
EVIDENCE_DIR="./storage/evidence"
MAX_UPLOAD_SIZE_BYTES=52428800

# ML Models Directory
MODELS_DIR="./ml/saved_models"
